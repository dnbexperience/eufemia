{
  "name": "@dnb/eufemia",
  "version": "0.0.0-development",
  "description": "DNB Eufemia Design System UI Library",
  "license": "SEE LICENSE IN LICENSE FILE",
  "author": "DNB Team & Tobias Høegh",
  "homepage": "https://eufemia.dnb.no/uilib",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnbexperience/eufemia.git",
    "directory": "packages/dnb-eufemia"
  },
  "bugs": {
    "url": "https://github.com/dnbexperience/eufemia/issues"
  },
  "main": "./index.js",
  "module": "./index.js",
  "bin": "./cli/eufemia.js",
  "scripts": {
    "audit:ci": "yarn npm audit --recursive --environment production --severity high",
    "build": "./scripts/prebuild/local-prebuild.sh",
    "prebuild:ci": "yarn build:prebuild && yarn verify:generated-entries:ci",
    "build:ci": "yarn prebuild:ci && yarn postbuild:ci && yarn publish:prepare",
    "postbuild:ci": "./scripts/postbuild/postbuild.sh",
    "build:cjs": "./scripts/postbuild/babel-cjs.sh",
    "build:copy": "./scripts/postbuild/copy-build-artifacts.sh",
    "build:docs": "babel-node --extensions .js,.ts,.tsx ../../tools/eufemia-llm-metadata/scripts/generateDocs.ts",
    "build:es": "./scripts/postbuild/babel-es.sh",
    "build:esm": "./scripts/postbuild/babel-esm.sh",
    "build:lebab": "babel-node --extensions .ts ./src/plugins/postcss-isolated-style-scope/scripts/transformToESM",
    "build:mini": "BUILD_MINI=1 yarn build:ci && rm -rf ./build/assets/icons ./build/assets/flags && find ./build/assets/fonts/ -type f \\( -name \"*.otf\" -o -name \"*.ttf\" -o -name \"*.zip\" \\) -delete",
    "build:pack": "yarn build && yarn publish:prepare && cd ./build && npm pack",
    "build:packages": "./scripts/postbuild/build-packages.sh",
    "build:prebuild": "babel-node --extensions .js,.ts,.tsx ./scripts/prebuild/runPrepub && yarn build:style-manifest && yarn build:validate-css",
    "build:resources": "babel-node --extensions .js,.ts,.tsx ./scripts/prebuild/resources/makeResourcesPackage",
    "build:size": "bundlewatch --config bundlewatch.config.js",
    "build:skills": "babel-node --extensions .js,.ts,.tsx ./scripts/postbuild/copyAgentSkills.ts",
    "build:style-manifest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ../../tools/eufemia-css-optimizer/src/cli.ts --source=./src --out=./build/style/style-manifest.json",
    "build:types:definitions": "yarn tsc --project tsconfig.definitions.json",
    "build:types:esm": "yarn tsc --project tsconfig.definitions.json --declarationDir ./build/esm --rootDir src",
    "build:validate-css": "babel-node --extensions .js,.ts,.tsx ./scripts/prebuild/validateCompiledCss.ts",
    "clean": "cd build && find . -type f ! -name 'CHANGELOG.md' -delete",
    "dev:packages": "nodemon --exec 'yarn build:packages && yarn build:copy' --ext js,html,json,css,scss --watch './src/**/*' --ignore './umd/*'",
    "dev:resources": "nodemon --exec 'babel-node --extensions .js,.ts,.tsx ./scripts/prebuild/resources/makeResourcesPackage' --ext js,html,json,css,scss --watch './build/style/**/*' --watch './scripts/**/*' --ignore '*.json'",
    "dev:tasks": "nodemon --exec 'babel-node --extensions .js,.ts,.tsx ./scripts/prebuild/dev' --watch 'tsdown.config.ts' --ext ts,js,html,json,css,scss --watch './src/components/**/*' --watch './scripts/**/*' --ignore '*.json'",
    "figma": "babel-node --extensions .js,.ts,.tsx ./scripts/figma/updateAll",
    "figma:icons:dev": "nodemon --exec 'babel-node --extensions .js,.ts,.tsx ./scripts/figma/updateIcons' --ignore '*.svg' --ignore '*.json'",
    "figma:refetch": "yarn figma --force-refetch",
    "figma:reset": "babel-node --extensions .js,.ts,.tsx ./scripts/figma/resetIcons && babel-node --extensions .js,.ts,.tsx ./scripts/tools/convertIcons",
    "icons:commit": "babel-node --extensions .js,.ts,.tsx ./scripts/figma/tasks/commitChanges",
    "icons:convert": "babel-node --extensions .js,.ts,.tsx ./scripts/tools/convertIcons && babel-node --extensions .js,.ts,.tsx ./scripts/figma/updateIcons",
    "icons:dev": "nodemon --exec 'babel-node --extensions .js,.ts,.tsx ./scripts/tools/convertIcons' --ext ts --ignore '/icons/**' --ignore '*.json'",
    "lint": "eslint --quiet --cache --cache-strategy content ./src ./scripts",
    "lint:ci": "yarn lint:lockfile && yarn lint:js && yarn lint:styles && yarn prettier:check && yarn prettier:package",
    "lint:js": "yarn lint",
    "lint:lockfile": "yarn lockfile-lint --path ../../yarn.lock --type yarn --allowed-schemes https: npm: workspace: patch: --allowed-hosts yarn github.com codeload.github.com",
    "lint:styles": "stylelint './src/**/*.scss'",
    "make-properties": "babel-node --extensions .js,.ts,.tsx ./scripts/prebuild/makeProperties",
    "prebuild:figma:ci": "yarn figma",
    "prettier:check": "prettier --check '{scripts,src}/**/*.{md,mdx,js,ts,tsx,scss,css,json}'",
    "prettier:js:write": "prettier --log-level warn --write '{scripts,src}/**/*.{js,ts,tsx}'",
    "prettier:other": "prettier --log-level warn './src/**/*.{json,md,mdx}' && yarn prettier:package",
    "prettier:other:write": "prettier --log-level warn --write './src/**/*.{json,md,mdx}' && yarn prettier:package",
    "prettier:package": "prettier-package-json --list-different ./package.json",
    "prettier:package:write": "prettier-package-json --write ./package.json",
    "prettier:styles:write": "prettier --log-level warn --parser scss --write './src/**/*.scss'",
    "prettier:write": "yarn prettier:js:write && yarn prettier:styles:write",
    "publish:ci": "yarn publish:prepare && ./scripts/postbuild/publish-release.sh",
    "publish:dry": "dotenv semantic-release --no-ci --dry-run",
    "publish:prepare": "./scripts/postbuild/publish-prepare.sh",
    "reset": "rm -rf ./node_modules ./build",
    "skeleton:font": "nodemon --exec 'babel-node --extensions .js,.ts,.tsx ./scripts/tools/createSkeletonFont.js'",
    "test": "yarn test:prepare && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/tools/vitest/runVitest.ts",
    "test:ci": "yarn test && yarn test:scripts",
    "test:deps": "depcruise -c .dependency-cruiser.js src",
    "test:e2e": "playwright test --config=./playwright.config.e2e.ts",
    "test:e2e:ci": "PLAYWRIGHT_BASE_URL=http://localhost:8001 start-server-and-test 'yarn workspace dnb-design-system-portal serve:8001' http://localhost:8001 test:e2e",
    "test:e2e:watch": "playwright test --config=./playwright.config.e2e.ts --ui",
    "test:postbuild": "vitest run --config vitest.config.postbuild.ts scripts/postbuild/__tests__/postbuild.test.ts scripts/postbuild/__tests__/validatePackageContents.test.ts",
    "test:postbuild:publish": "vitest run --config vitest.config.postbuild.ts scripts/postbuild/__tests__/prepareForRelease.test.ts",
    "test:prepare": "yarn build:style-manifest",
    "test:screenshots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/tools/vitest/runScreenshotVitest.ts",
    "test:screenshots:ci": "yarn test:screenshots",
    "test:screenshots:ci:conditional": "babel-node --extensions .js,.ts,.tsx ./scripts/tools/runScreenshotsConditionally/cli.ts",
    "test:screenshots:ci:conditional:explain": "babel-node --extensions .js,.ts,.tsx ./scripts/tools/runScreenshotsConditionally/cli.ts --explain",
    "test:screenshots:ci:update": "yarn test:screenshots:update",
    "test:screenshots:renew": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/tools/vitest/renewScreenshots.ts",
    "test:screenshots:update": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/tools/vitest/runScreenshotVitest.ts --update=true",
    "test:screenshots:watch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/tools/vitest/runScreenshotVitest.ts --watch",
    "test:scripts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/tools/vitest/runVitest.ts --preset=scripts",
    "test:types": "tsc --noEmit --incremental --tsBuildInfoFile tsconfig.tsbuildinfo",
    "test:types:watch": "tsc --noEmit --watch",
    "test:update": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/tools/vitest/runVitest.ts --update=true",
    "test:watch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types ./scripts/tools/vitest/runVitest.ts --watch",
    "validate:package": "node ./scripts/postbuild/validatePackageContents.mjs build",
    "verify:generated-entries:ci": "babel-node --extensions .js,.ts,.tsx ./scripts/prebuild/tasks/verifyGeneratedEntriesCommitted"
  },
  "sideEffects": [
    "*.css",
    "*.min.css",
    "*.scss",
    "umd/*",
    "style/**/*",
    "es/style/**/*",
    "esm/style/**/*",
    "src/style/**/*"
  ],
  "types": "./index.d.ts",
  "dependencies": {
    "@babel/runtime-corejs3": "7.28.4",
    "@inquirer/checkbox": "5.2.1",
    "@maskito/core": "5.4.0",
    "@maskito/kit": "5.4.0",
    "@maskito/react": "5.4.0",
    "@navikt/fnrvalidator": "2.2.1",
    "@ungap/structured-clone": "1.3.1",
    "ajv": "8.20.0",
    "ajv-errors": "3.0.0",
    "clsx": "2.1.1",
    "core-js-pure": "3.47.0",
    "date-fns": "4.4.0",
    "intl-messageformat": "11.2.3",
    "postcss-selector-parser": "7.1.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "purgecss": "^8.0.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "purgecss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/cli": "7.28.3",
    "@babel/core": "7.29.7",
    "@babel/node": "7.28.0",
    "@babel/plugin-transform-export-namespace-from": "7.27.1",
    "@babel/plugin-transform-modules-commonjs": "7.27.1",
    "@babel/plugin-transform-nullish-coalescing-operator": "7.27.1",
    "@babel/plugin-transform-react-constant-elements": "7.27.1",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@blazediff/core": "1.9.1",
    "@dnb/browserslist-config": "1.4.1",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/server-legacy": "2.0.0",
    "@playwright/test": "1.60.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.8",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@svgr/core": "6.5.1",
    "@svgr/plugin-jsx": "6.5.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.7.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/express": "^5",
    "@types/json-schema": "7.0.12",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/eslint-plugin": "1.6.19",
    "babel-plugin-fully-specified": "1.3.1",
    "babel-plugin-optimize-clsx": "2.6.2",
    "babel-plugin-polyfill-corejs3": "0.13.0",
    "babel-plugin-search-and-replace": "1.1.1",
    "babel-plugin-transform-next-use-client": "1.1.1",
    "bundlewatch": "0.4.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "cross-env": "7.0.3",
    "cssnano": "6.0.1",
    "dependency-cruiser": "17.3.8",
    "dnb-design-system-portal": "workspace:*",
    "dotenv-cli": "4.1.0",
    "eslint": "10.4.1",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.10.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.0.0",
    "express": "5.2.1",
    "fonteditor-core": "2.6.3",
    "fs-extra": "10.0.0",
    "globals": "17.6.0",
    "globby": "11.0.4",
    "hono": "4.12.34",
    "jest-axe": "11.0.0",
    "jsdom": "29.1.1",
    "lebab": "3.2.7",
    "lightningcss": "1.32.0",
    "lockfile-lint": "4.14.1",
    "mock-match-media": "0.3.0",
    "nodemon": "3.1.14",
    "opentype.js": "1.3.4",
    "ora": "5.4.1",
    "playwright": "1.60.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.23",
    "postcss-preset-env": "11.2.1",
    "prettier": "3.8.1",
    "prettier-package-json": "2.8.0",
    "purgecss": "8.0.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "repo-utils": "workspace:*",
    "sass": "1.97.2",
    "semantic-release": "25.0.3",
    "simple-git": "3.36.0",
    "start-server-and-test": "3.0.11",
    "stylelint": "16.26.1",
    "stylelint-config-recommended": "15.0.0",
    "stylelint-config-standard-scss": "15.0.1",
    "svgo": "3.3.4",
    "tar": "7.5.21",
    "traverse": "0.6.6",
    "tsdown": "0.14.2",
    "typescript": "5.9.3",
    "vd-tool": "4.0.2",
    "vite": "8.0.16",
    "vitest": "4.1.10"
  },
  "keywords": [
    "Accessibility",
    "DNB",
    "Design System",
    "Eufemia",
    "UX"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "release": {
    "branches": [
      "+([0-9])?(.{+([0-9]),x}).x",
      "release",
      {
        "name": "next",
        "prerelease": true
      },
      {
        "name": "beta",
        "prerelease": true
      },
      {
        "name": "alpha",
        "prerelease": true
      }
    ],
    "ci": true,
    "debug": false,
    "dryRun": false,
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "parserOpts": {
            "noteKeywords": [
              "BREAKING CHANGE(?=:)",
              "BREAKING-CHANGE(?=:)"
            ]
          }
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "parserOpts": {
            "noteKeywords": [
              "BREAKING CHANGE(?=:)",
              "BREAKING-CHANGE(?=:)"
            ]
          },
          "presetConfig": {
            "types": [
              {
                "type": "major",
                "section": ":muscle: Major Changes",
                "hidden": false
              },
              {
                "type": "feat",
                "section": ":sparkles: Features",
                "hidden": false
              },
              {
                "type": "fix",
                "section": ":bug: Bug Fixes",
                "hidden": false
              },
              {
                "type": "docs",
                "section": ":memo: Documentation",
                "hidden": false
              },
              {
                "type": "style",
                "section": ":barber: Style Changes",
                "hidden": false
              },
              {
                "type": "design",
                "section": ":art: Design Changes",
                "hidden": false
              },
              {
                "type": "refactor",
                "section": ":zap: Refactoring",
                "hidden": false
              },
              {
                "type": "perf",
                "section": ":fast_forward: Performance Improvements",
                "hidden": false
              },
              {
                "type": "test",
                "section": ":white_check_mark: Tests",
                "hidden": false
              },
              {
                "type": "deps",
                "section": ":package: Dependencies",
                "hidden": false
              }
            ]
          }
        }
      ],
      [
        "@semantic-release/changelog",
        {
          "changelogTitle": "# Changelog\n\nAll notable changes to @dnb/eufemia will be documented in this file. See\n[Conventional Commits](https://conventionalcommits.org) for commit guidelines."
        }
      ],
      [
        "@semantic-release/npm",
        {
          "tarballDir": "../dist",
          "npmPublish": true,
          "pkgRoot": "."
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": "../dist/*.tgz"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci] \n\n${nextRelease.notes}"
        }
      ]
    ]
  },
  "volta": {
    "extends": "../../package.json"
  }
}
