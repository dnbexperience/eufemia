// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Badge scss > should match style dependencies css 1`] = `
"/*
* Used for snapshot testing
*
*/
/*
* Badge component
*
*/
/*
 * Utilities
 */
.dnb-badge {
  display: inline-flex;
  flex-flow: row wrap;
  white-space: nowrap;
  justify-content: center;
  align-content: center;
  align-items: center;
  font-weight: var(--font-weight-medium);
  font-size: var(--font-size-x-small);
}
.dnb-badge__root {
  position: relative;
  display: inline-flex;
  vertical-align: middle;
  flex-shrink: 0;
}
.dnb-badge__root--button-left > .dnb-button--has-text {
  padding-left: max(var(--button-padding-left), var(--badge-width, 1.5rem) + 0.25rem);
}
.dnb-badge__root--button-right > .dnb-button--has-text {
  padding-right: max(var(--button-padding-right), var(--badge-width, 1.5rem) + 0.25rem);
}
.dnb-badge__root > .dnb-button--has-icon:not(.dnb-button--has-text) + .dnb-badge--variant-notification:not(.dnb-badge--indicator) {
  transform: translate(var(--badge-button-offset-x, 0%), var(--badge-button-offset-y, 0%));
}
.dnb-badge__root > .dnb-button--has-icon:not(.dnb-button--has-text) + .dnb-badge--variant-notification:not(.dnb-badge--indicator).dnb-badge--horizontal-left {
  --badge-button-offset-x: calc(-100% + 0.75rem);
}
.dnb-badge__root > .dnb-button--has-icon:not(.dnb-button--has-text) + .dnb-badge--variant-notification:not(.dnb-badge--indicator).dnb-badge--horizontal-right {
  --badge-button-offset-x: calc(100% - 0.75rem);
}
.dnb-badge__root > .dnb-button--has-icon:not(.dnb-button--has-text) + .dnb-badge--variant-notification:not(.dnb-badge--indicator).dnb-badge--vertical-top {
  --badge-button-offset-y: -50%;
}
.dnb-badge__root > .dnb-button--has-icon:not(.dnb-button--has-text) + .dnb-badge--variant-notification:not(.dnb-badge--indicator).dnb-badge--vertical-bottom {
  --badge-button-offset-y: 50%;
}
.dnb-badge__root .dnb-badge {
  display: flex;
  overflow: hidden;
  position: absolute;
  z-index: 2;
  pointer-events: none;
}
.dnb-badge--variant-notification {
  line-height: normal;
  color: var(--token-color-text-neutral-ondark);
  background-color: var(--token-color-background-error);
  padding: 0 0.25rem;
  min-width: 1.5rem;
  height: 1.5rem;
  border-radius: var(--token-radius-full);
}
.dnb-badge--variant-notification.dnb-badge--indicator {
  min-width: 0.5rem;
  height: 0.5rem;
  padding: 0;
}
.dnb-badge--variant-information {
  --badge-information-color: var(--token-color-text-neutral);
  padding: 0.125rem 0.5rem;
  border-radius: var(--token-radius-md);
  background-color: var(--badge-information-bg);
  color: var(--badge-information-color, inherit);
}
.dnb-badge__icon {
  margin-inline-end: 0.5rem;
}
.dnb-badge--subtle {
  background-color: var(--badge-information-subtle-bg);
  color: var(--badge-information-subtle-color, var(--badge-information-color));
  --border-color: var(--badge-information-subtle-border);
  --border-width: 0.0625rem;
  box-shadow: inset 0 0 0 var(--border-width) var(--border-color);
  border-color: transparent;
}
.dnb-badge--horizontal-left {
  left: 0;
}
.dnb-badge--horizontal-right {
  right: 0;
}
.dnb-badge--vertical-bottom {
  bottom: 0;
}
.dnb-badge--vertical-top {
  top: 0;
}
.dnb-badge--inline.dnb-badge--vertical-top {
  transform: translateY(-25%);
}
.dnb-badge--inline.dnb-badge--vertical-bottom {
  transform: translateY(25%);
}
.dnb-badge--status-default {
  --badge-information-bg: var(--token-color-decorative-first-subtle);
  --badge-information-subtle-bg: var(
    --token-color-decorative-first-muted
  );
  --badge-information-subtle-border: var(
    --token-color-decorative-first-subtle
  );
}
.dnb-badge--status-neutral {
  --badge-information-bg: var(--token-color-background-neutral-base);
  --badge-information-subtle-bg: var(
    --token-color-background-neutral-subtle
  );
  --badge-information-subtle-border: var(
    --token-color-stroke-neutral-bold
  );
}
.dnb-badge--status-positive {
  --badge-information-bg: var(--token-color-background-positive);
  --badge-information-color: var(--token-color-text-neutral-inverse);
  --badge-information-subtle-bg: var(
    --token-color-background-positive-subtle
  );
  --badge-information-subtle-color: var(--token-color-text-positive);
  --badge-information-subtle-border: var(--token-color-stroke-positive);
}
.dnb-badge--status-warning {
  --badge-information-bg: var(--token-color-background-warning);
  --badge-information-color: var(--token-color-text-neutral-onlight);
  --badge-information-subtle-bg: var(
    --token-color-background-warning-subtle
  );
  --badge-information-subtle-color: var(--token-color-text-warning);
  --badge-information-subtle-border: var(--token-color-stroke-warning);
}
.dnb-badge--status-negative {
  --badge-information-bg: var(--token-color-background-error);
  --badge-information-color: var(--token-color-text-neutral-ondark);
  --badge-information-subtle-bg: var(
    --token-color-background-error-subtle
  );
  --badge-information-subtle-color: var(--token-color-text-error);
  --badge-information-subtle-border: var(--token-color-stroke-error);
}"
`;
