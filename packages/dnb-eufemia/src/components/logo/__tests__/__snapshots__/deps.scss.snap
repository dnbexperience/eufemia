/*
* Used for snapshot testing
*
*/
/*
 * Logo Component
 *
 */
.dnb-logo {
  display: inline-block;
  vertical-align: baseline;
  font-size: inherit;
  line-height: 0;
  height: 1em;
}
.dnb-logo--has-size {
  width: auto;
  height: auto;
}
.dnb-logo--inherit-size {
  height: inherit;
}
.dnb-logo--inherit-color {
  color: currentcolor;
}
.dnb-logo--inherit-color svg {
  fill: currentcolor;
}
.dnb-logo svg {
  shape-rendering: geometricprecision;
}
.dnb-logo svg[color] {
  fill: currentcolor;
}
.dnb-logo svg:not([width], [height]) {
  width: inherit;
  height: inherit;
}
.dnb-logo svg:not(:root) {
  overflow: visible;
}