exports[`NumberFormat scss > has to match style dependencies css 1`] = `
"/*
* Used for snapshot testing
*
*/
/*
* Used for snapshot testing
*
*/
/*
* Tooltip component
*
*/
/*
 * Utilities
 */
:root {
  --tooltip-z-index: var(--z-index-tooltip);
}

.dnb-tooltip {
  --inner-space: 0;
  --tooltip-border-radius: var(--token-radius-lg);
  --popover-text-color: var(--token-color-text-neutral-inverse);
  --popover-background-color: var(
    --token-color-component-tooltip-background-neutral
  );
  z-index: var(--tooltip-z-index);
}
.dnb-tooltip--hide {
  pointer-events: none;
}
html[data-dnb-modal-active] .dnb-tooltip--hide {
  z-index: calc(var(--modal-z-index) + var(--tooltip-z-index));
}
.dnb-popover--inside-modal .dnb-tooltip {
  z-index: calc(var(--modal-z-index) + var(--tooltip-z-index));
}
.dnb-tooltip {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-width: auto;
  text-align: center;
  border-radius: var(--tooltip-border-radius);
  box-shadow: var(--shadow-default);
}
.dnb-tooltip--large {
  padding: 0.25rem 0;
}
.dnb-tooltip .dnb-popover__content {
  min-width: 2rem;
  max-width: 37rem;
  min-height: 1.5rem;
  padding: 0 1rem;
}
.dnb-tooltip .dnb-popover__arrow__placement--right {
  left: -13px;
  top: auto !important;
}
.dnb-tooltip .dnb-popover__arrow__placement--left {
  right: -13px;
  top: auto !important;
}

/*
 * NumberFormat Component
 *
 */
.dnb-animated-digits {
  position: relative;
  display: inline-block;
  direction: ltr;
  unicode-bidi: isolate;
  text-align: inherit;
  font-variant-numeric: tabular-nums;
  white-space: pre;
}
.dnb-animated-digits__text::before, .dnb-animated-digits__formatted-literal::before {
  content: attr(data-text);
}
.dnb-animated-digits__visual {
  position: absolute;
  inset: 0;
  display: none;
  pointer-events: none;
}
.dnb-animated-digits__visual > span:first-child {
  position: relative;
  display: inline-block;
  width: 0;
  vertical-align: top;
}
.dnb-animated-digits__visual > span:first-child::before {
  position: absolute;
  left: 0;
  content: attr(data-text);
}
.dnb-animated-digits__viewport {
  display: inline-block;
  width: 100%;
  text-align: left;
  overflow: hidden;
  overflow: clip;
}
.dnb-animated-digits--reserved .dnb-animated-digits__viewport {
  width: auto;
  max-width: 100%;
}
.dnb-animated-digits__content {
  position: relative;
  left: 100%;
  display: inline-block;
  transform: translateX(-100%);
}
.dnb-animated-digits__prefix {
  visibility: hidden;
}
.dnb-animated-digits__prefix::before {
  content: attr(data-text);
}
.dnb-animated-digits__character {
  position: relative;
  display: inline-block;
  vertical-align: bottom;
  overflow: hidden;
  overflow: clip;
}
.dnb-animated-digits__removed {
  position: absolute;
  transform: translateX(-100%);
  display: none;
  overflow: hidden;
  overflow: clip;
}
.dnb-animated-digits__removed > span {
  display: inline-block;
}
.dnb-animated-digits__removed > span::before {
  content: attr(data-previous);
}
.dnb-animated-digits__previous {
  position: absolute;
  inset: 0;
  display: none;
  visibility: hidden;
}
.dnb-animated-digits__previous::before {
  content: attr(data-previous);
}
.dnb-animated-digits__value {
  display: inline-block;
}
.dnb-animated-digits__value::before {
  content: attr(data-text);
}
.dnb-animated-digits__formatted {
  position: relative;
  display: inline;
  direction: ltr;
  unicode-bidi: isolate;
  font-variant-numeric: tabular-nums;
  white-space: normal;
}
.dnb-animated-digits__formatted--fluid {
  display: inline-block;
  white-space: pre;
}
.dnb-animated-digits__formatted-visual {
  position: absolute;
  inset: 0;
  display: none;
  pointer-events: none;
}
@media screen and (prefers-reduced-motion: no-preference) and (forced-colors: none) {
  .dnb-animated-digits__text, .dnb-animated-digits__formatted-text {
    color: transparent;
  }
  .dnb-animated-digits__visual {
    display: inline-block;
  }
  .dnb-animated-digits__formatted-text {
    position: absolute;
    pointer-events: none;
  }
  .dnb-animated-digits__formatted--fluid > .dnb-animated-digits__formatted-text {
    pointer-events: auto;
  }
  .dnb-animated-digits__formatted-visual {
    position: relative;
    inset: auto;
    display: inline;
  }
  .dnb-animated-digits__formatted--fluid > .dnb-animated-digits__formatted-visual {
    display: inline-block;
  }
  .dnb-animated-digits__removed {
    display: inline-block;
    animation: dnb-animated-digits-remove 160ms ease-out both;
  }
  .dnb-animated-digits__character--animated .dnb-animated-digits__previous {
    display: block;
    animation: dnb-animated-digits-out 160ms ease-out both;
    animation-delay: inherit;
  }
  .dnb-animated-digits__character--animated .dnb-animated-digits__value {
    animation: dnb-animated-digits-in 160ms ease-out both;
    animation-delay: inherit;
  }
  .dnb-animated-digits--down .dnb-animated-digits__character--animated .dnb-animated-digits__previous {
    animation-name: dnb-animated-digits-out-down;
  }
  .dnb-animated-digits--down .dnb-animated-digits__character--animated .dnb-animated-digits__value {
    animation-name: dnb-animated-digits-in-down;
  }
}

@keyframes dnb-animated-digits-remove {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}
@keyframes dnb-animated-digits-in {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}
@keyframes dnb-animated-digits-out {
  from {
    visibility: visible;
    transform: translateY(0);
  }
  to {
    transform: translateY(-100%);
    visibility: hidden;
  }
}
@keyframes dnb-animated-digits-in-down {
  from {
    transform: translateY(-100%);
  }
  to {
    transform: translateY(0);
  }
}
@keyframes dnb-animated-digits-out-down {
  from {
    visibility: visible;
    transform: translateY(0);
  }
  to {
    transform: translateY(100%);
    visibility: hidden;
  }
}
.dnb-number-format {
  display: inline-block;
  position: relative;
  white-space: nowrap;
}
html:not([data-whatinput=touch]) .dnb-number-format.dnb-tab-focus:focus-visible[disabled] {
  cursor: not-allowed;
}
html:not([data-whatinput=touch]) .dnb-number-format.dnb-tab-focus:focus-visible:not([disabled]) {
  box-shadow: none;
  border-radius: var(--token-radius-sm);
  outline: var(--focus-outline-width) solid var(--token-color-stroke-action-focus);
  outline-offset: var(--focus-outline-offset);
}
.dnb-number-format .dnb-sr-only::before {
  content: attr(data-text);
}
.dnb-number-format__prefix, .dnb-number-format__suffix {
  white-space: normal;
}
.dnb-number-format.dnb-anchor {
  cursor: pointer;
}
.dnb-number-format--select-all {
  cursor: text;
}
.dnb-number-format__visible {
  position: relative;
  z-index: 2;
}
.dnb-number-format__symbol {
  display: inline-block;
  white-space: pre;
}
.dnb-number-format--selected .dnb-number-format__visible {
  color: var(--token-color-text-neutral);
  background-color: var(--token-color-background-action-pressed-subtle);
}
.dnb-number-format__selection {
  position: absolute;
  z-index: 1;
  top: 0;
  left: 0;
  opacity: 0;
  user-select: none;
}
.dnb-number-format--selected .dnb-number-format__selection {
  z-index: 3;
  user-select: all;
}
.dnb-number-format--monospace {
  font-family: var(--font-family-monospace);
}
.dnb-number-format.dnb-skeleton, .dnb-skeleton .dnb-number-format {
  -webkit-text-fill-color: var(--skeleton-color);
}"
`;
