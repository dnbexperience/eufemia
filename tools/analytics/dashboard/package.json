{
  "name": "eufemia-analytics-dashboard",
  "description": "Eufemia analytics dashboard UI (React + Vite + @dnb/eufemia)",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "DNB Team",
  "license": "SEE LICENSE IN LICENSE FILE",
  "scripts": {
    "dev": "yarn workspace @dnb/eufemia build:style-manifest && vite --configLoader runner",
    "build": "yarn workspace @dnb/eufemia build:style-manifest && vite build --configLoader runner",
    "preview": "yarn workspace @dnb/eufemia build:style-manifest && vite preview --configLoader runner",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && prettier --check 'src/**/*.{ts,tsx}' 'index.html' '*.{json,md}'"
  },
  "dependencies": {
    "@dnb/eufemia": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "10.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "prettier": "3.8.1",
    "purgecss": "8.0.0",
    "sass": "1.97.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vite": "8.0.16",
    "vitest": "4.1.11"
  },
  "volta": {
    "extends": "../../../package.json"
  }
}
