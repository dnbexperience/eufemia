# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# BA number from ServiceNow used for cost allocation tagging.
cost_allocation = "BSN00000000"

# environment = "dev"

# Subscribes this address to the snapshot alert SNS topic. Leave unset to ship
# the topic without a subscriber.
# snapshot_alert_email = "alerts@example.com"
