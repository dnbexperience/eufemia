# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# BA number from ServiceNow used for cost allocation tagging.
cost_allocation = "BSN00000000"

# environment = "dev"

# Subscribes these comma-separated addresses to the snapshot alert SNS topic.
# Leave unset to ship the topic without a subscriber.
# snapshot_alert_emails = "alerts@example.com, oncall@example.com"
